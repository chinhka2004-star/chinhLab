#
# Labtainer Dockerfile
#
ARG registry
FROM $registry/labtainer.base

# Install ffmpeg and required Python3 packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    python3-pillow \
    && rm -rf /var/lib/apt/lists/*

# Set up the student workspace directory and configure correct permissions
RUN mkdir -p /home/ubuntu/stego_lab && chown -R ubuntu:ubuntu /home/ubuntu

USER ubuntu
ENV HOME /home/ubuntu
WORKDIR /home/ubuntu/stego_lab
